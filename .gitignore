backend/data/keyframes/*
!backend/data/keyframes/.gitkeep
backend/data/lancedb/*
!backend/data/lancedb/.gitkeep
backend/data/clips/*
!backend/data/clips/.gitkeep
backend/data/*.log
*.log

# Evaluation Datasets
evaluation/datasets/*.json
evaluation/datasets/*.mp4

