# Copy to backend/.env and fill in HF_TOKEN if the selected checkpoint requires it.
HF_TOKEN=
SIGLIP2_MODEL_ID=google/siglip2-base-patch16-naflex
QWEN_VL_MODEL_ID=Qwen/Qwen3-VL-2B-Instruct
SAM_MODEL_ID=facebook/sam3.1
ENABLE_SAM_GROUNDING=false
VLM_LAB_DISABLE_SAM=true
VLM_LAB_ENABLED=true
VLM_DEFAULT_BACKEND=qwen3_vl_2b
VLM_ARTIFACT_VERSION=vlm-ablation-v1
VLM_CAPTION_PROMPT_VERSION=scene-caption-vlm-ablation-v1
VLM_VIDEO_PROMPT_VERSION=video-caption-vlm-ablation-v1
VLM_VIDEO_CHUNK_SEC=8
VLM_VIDEO_CHUNK_STRIDE_SEC=4
VLM_VIDEO_SAMPLE_FPS=2
VLM_VIDEO_MAX_FRAMES=16
VLM_FRAME_MAX_FRAMES=4
VLM_CAPTION_MAX_NEW_TOKENS=256
VLM_JSON_REPAIR_MAX_NEW_TOKENS=192
VLM_VIDEO_USE_CONTAINER=false

# Main API -> local-only worker boundary.
INFERENCE_WORKER_ENABLED=false
INFERENCE_WORKER_URL=http://127.0.0.1:8011
INFERENCE_WORKER_TOKEN=change-this-local-secret
INFERENCE_REQUEST_TIMEOUT_SEC=35
MODEL_VRAM_BUDGET_MB=11800
INFERENCE_WARMUP_QWEN=false

CAPTION_VERSION=qwen3vl2b-v1
GROUNDING_VERSION=sam31-v1
ACCURATE_MAX_SECONDS=60
SAM_SEARCH_TOP_K=2
SAM_STRONG_SCORE_THRESHOLD=0.70
QWEN_FALLBACK_TOP_K=1
QWEN_MIN_REMAINING_SECONDS=12
QWEN_MAX_FRAMES_PER_CANDIDATE=4
VLM_VERIFY_FRAMES_PER_MOMENT=4
SAM_COMPILE=false
SAM_PRECOMPUTE_FPS=1
SAM_SEARCH_FPS=4
SAM_MAX_WINDOW_SEC=12
SAM_MAX_FRAMES_PER_WINDOW=48
LLAMA_CPP_PATH=
VLM_GGUF_DIR=
LLAMA_CPP_VERSION=0.4.1-b29c606
